
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QuizNova - AI Quiz Generator</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #080d1b;
  color: white;
  min-height: 100vh;
}

header {
  padding: 22px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #252c42;
}

.logo {
  font-size: 25px;
  font-weight: bold;
  color: #9b8cff;
}

.logo span {
  color: white;
}

.badge {
  background: #192342;
  color: #a99bff;
  padding: 9px 15px;
  border-radius: 20px;
  font-size: 12px;
}

.container {
  max-width: 850px;
  margin: 45px auto;
  padding: 20px;
}

.hero {
  text-align: center;
  margin-bottom: 35px;
}

.hero h1 {
  font-size: 42px;
  margin-bottom: 14px;
}

.hero h1 span {
  color: #a18cff;
}

.hero p {
  color: #a6aec4;
  line-height: 1.6;
}

.card {
  background: #111a30;
  border: 1px solid #283451;
  border-radius: 18px;
  padding: 28px;
  margin-bottom: 22px;
}

.card h2 {
  font-size: 20px;
  margin-bottom: 20px;
}

label {
  display: block;
  margin: 16px 0 9px;
  color: #c9d0e2;
  font-size: 14px;
}

input, select {
  width: 100%;
  padding: 14px;
  background: #0b1224;
  border: 1px solid #34415e;
  color: white;
  border-radius: 10px;
  outline: none;
  font-size: 15px;
}

input:focus, select:focus {
  border-color: #9b8cff;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

button {
  border: none;
  cursor: pointer;
  border-radius: 10px;
  padding: 14px 20px;
  font-size: 15px;
  font-weight: bold;
  transition: 0.2s;
}

button:hover {
  transform: translateY(-2px);
  opacity: 0.9;
}

.generate {
  width: 100%;
  margin-top: 24px;
  color: white;
  background: linear-gradient(100deg, #7059ed, #a15ee9);
}

.secondary {
  background: #263451;
  color: white;
  margin-top: 15px;
}

.question {
  background: #17233e;
  padding: 20px;
  border-radius: 12px;
  margin: 18px 0;
  border: 1px solid #34415e;
}

.question h3 {
  font-size: 17px;
  line-height: 1.5;
  margin-bottom: 15px;
}

.option {
  display: block;
  padding: 12px;
  border: 1px solid #394866;
  border-radius: 9px;
  margin-top: 9px;
  cursor: pointer;
  color: #dce3f4;
}

.option:hover {
  border-color: #9b8cff;
  background: #273253;
}

.option input {
  width: auto;
  margin-right: 10px;
}

.option.correct {
  border-color: #25ce8b;
  background: #123c35;
}

.option.wrong {
  border-color: #ff626f;
  background: #48232e;
}

.result {
  text-align: center;
  padding: 25px;
  background: #17233e;
  border-radius: 12px;
  margin-top: 20px;
}

.result h2 {
  color: #a18cff;
  font-size: 32px;
}

#quizSection, #resultSection {
  display: none;
}

.status {
  margin-top: 15px;
  color: #b5a8ff;
  text-align: center;
  font-size: 14px;
  white-space: pre-wrap;
}

footer {
  text-align: center;
  color: #79839d;
  padding: 25px;
  font-size: 13px;
}

@media(max-width:600px) {
  .hero h1 {
    font-size: 31px;
  }
  .grid {
    grid-template-columns: 1fr;
  }
  .card {
    padding: 19px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">Quiz<span>Nova.</span></div>
  <div class="badge">✦ POWERED BY AI</div>
</header>

<div class="container">

  <div class="hero">
    <h1>AI Quiz <span>Generator</span></h1>
    <p>Create smart quizzes on any topic with Artificial Intelligence.</p>
  </div>

  <div class="card" id="setupSection">
    <h2>⚙️ Quiz Settings</h2>

    <label>Groq API Key</label>
    <input type="password" id="apiKey"
      placeholder="Enter your Groq API Key">

    <label>Quiz Topic</label>
    <input type="text" id="topic"
      placeholder="Example: Science, Computer, History">

    <div class="grid">
      <div>
        <label>Difficulty</label>
        <select id="difficulty">
          <option>Easy</option>
          <option selected>Medium</option>
          <option>Hard</option>
        </select>
      </div>

      <div>
        <label>Number of Questions</label>
        <select id="count">
          <option value="5">5 Questions</option>
          <option value="10" selected>10 Questions</option>
          <option value="15">15 Questions</option>
        </select>
      </div>
    </div>

    <button class="generate" id="generateBtn" onclick="generateQuiz()">
      ✨ Generate My Quiz
    </button>

    <div class="status" id="status"></div>
  </div>

  <div class="card" id="quizSection">
    <h2>📝 Your Quiz</h2>
    <div id="questions"></div>
    <button class="generate" onclick="submitQuiz()">
      Submit Answers →
    </button>
  </div>

  <div class="card" id="resultSection">
    <div class="result">
      <h2 id="score">0/0</h2>
      <p id="message">Quiz Completed!</p>
      <button class="generate" onclick="restartQuiz()">
        🔄 Create Another Quiz
      </button>
    </div>
  </div>

</div>

<footer>
  QuizNova © 2026 | AI Powered Learning Platform
</footer>

<script>
let quizData = [];
let submitted = false;

async function generateQuiz() {

  const apiKey = document.getElementById("apiKey").value.trim();
  const topic = document.getElementById("topic").value.trim();
  const difficulty = document.getElementById("difficulty").value;
  const count = Number(document.getElementById("count").value);

  const status = document.getElementById("status");
  const btn = document.getElementById("generateBtn");

  if (!apiKey) {
    alert("Please enter your Groq API Key!");
    return;
  }

  if (!topic) {
    alert("Please enter a quiz topic!");
    return;
  }

  btn.disabled = true;
  btn.textContent = "Generating Quiz...";
  status.textContent = "✨ AI is creating your questions...";

  document.getElementById("quizSection").style.display = "none";
  document.getElementById("resultSection").style.display = "none";

  const prompt = `
Create exactly ${count} multiple choice quiz questions.

Topic: ${topic}
Difficulty: ${difficulty}

Return ONLY valid JSON in this format:
{
  "questions": [
    {
      "question": "Question text",
      "options": ["Option A", "Option B", "Option C", "Option D"],
      "answer": 0,
      "explanation": "Explanation of the correct answer"
    }
  ]
}

Rules:
- Exactly ${count} questions.
- Every question must have exactly four options.
- answer must be an integer from 0 to 3.
- Questions must be factually correct.
- Do not repeat questions.
- Explanation should be short.
- Do not include markdown.
`;

  try {

    const response = await fetch(
      "https://api.groq.com/openai/v1/chat/completions",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": "Bearer " + apiKey
        },
        body: JSON.stringify({
          model: "llama-3.3-70b-versatile",
          messages: [
            {
              role: "system",
              content: "You are an expert quiz creator. Return valid JSON only."
            },
            {
              role: "user",
              content: prompt
            }
          ],
          temperature: 0.7,
          response_format: {
            type: "json_object"
          }
        })
      }
    );

    const data = await response.json();

    if (!response.ok) {
      throw new Error(
        data.error?.message || "API request failed: " + response.status
      );
    }

    const content = data.choices?.[0]?.message?.content;

    if (!content) {
      throw new Error("AI returned an empty response.");
    }

    const parsed = JSON.parse(content);

    if (!Array.isArray(parsed.questions) ||
        parsed.questions.length !== count) {
      throw new Error("AI returned an unexpected number of questions. Please try again.");
    }

    quizData = parsed.questions;

    quizData.forEach(q => {
      if (
        typeof q.question !== "string" ||
        !Array.isArray(q.options) ||
        q.options.length !== 4 ||
        !Number.isInteger(q.answer) ||
        q.answer < 0 ||
        q.answer > 3
      ) {
        throw new Error("Invalid quiz format. Please generate again.");
      }
    });

    showQuiz();

    status.textContent = "✅ Quiz generated successfully!";

  } catch (error) {

    status.textContent = "❌ " + error.message;
    console.error(error);

  } finally {

    btn.disabled = false;
    btn.textContent = "✨ Generate My Quiz";

  }
}

function showQuiz() {

  const container = document.getElementById("questions");
  container.innerHTML = "";
  submitted = false;

  quizData.forEach((q, index) => {

    let html = `
      <div class="question" id="question${index}">
        <h3>${index + 1}. ${escapeHTML(q.question)}</h3>
    `;

    q.options.forEach((option, i) => {

      html += `
        <label class="option" id="option${index}_${i}">
          <input type="radio"
            name="q${index}"
            value="${i}">
          ${escapeHTML(option)}
        </label>
      `;

    });

    html += `</div>`;

    container.innerHTML += html;

  });

  document.getElementById("quizSection").style.display = "block";

  document.getElementById("quizSection")
    .scrollIntoView({ behavior: "smooth" });
}

function submitQuiz() {

  if (submitted) return;

  let score = 0;
  let unanswered = 0;

  quizData.forEach((q, index) => {

    const selected = document.querySelector(
      `input[name="q${index}"]:checked`
    );

    if (!selected) {
      unanswered++;
    }

  });

  if (unanswered > 0) {
    alert("Please answer all questions first!");
    return;
  }

  quizData.forEach((q, index) => {

    const selected = document.querySelector(
      `input[name="q${index}"]:checked`
    );

    const userAnswer = Number(selected.value);

    const correctLabel = document.getElementById(
      `option${index}_${q.answer}`
    );

    correctLabel.classList.add("correct");

    if (userAnswer === q.answer) {
      score++;
    } else {

      document.getElementById(
        `option${index}_${userAnswer}`
      ).classList.add("wrong");

    }

    const explanation = document.createElement("p");
    explanation.style.color = "#b9c5df";
    explanation.style.marginTop = "12px";
    explanation.textContent =
      "💡 " + (q.explanation || "Correct answer shown above.");

    document.getElementById(
      `question${index}`
    ).appendChild(explanation);

    document.querySelectorAll(
      `input[name="q${index}"]`
    ).forEach(input => input.disabled = true);

  });

  submitted = true;

  document.getElementById("score").textContent =
    score + " / " + quizData.length;

  let percentage = Math.round(
    (score / quizData.length) * 100
  );

  let message = "";

  if (percentage === 100) {
    message = "🏆 Perfect Score! Excellent Work!";
  } else if (percentage >= 70) {
    message = "🎉 Great Job! Keep Learning!";
  } else if (percentage >= 40) {
    message = "👍 Good Try! Keep Practicing!";
  } else {
    message = "📚 Keep Learning and Try Again!";
  }

  document.getElementById("message").textContent =
    message + " Your score: " + percentage + "%";

  document.getElementById("resultSection").style.display = "block";

  document.getElementById("resultSection")
    .scrollIntoView({ behavior: "smooth" });

}

function restartQuiz() {

  document.getElementById("quizSection").style.display = "none";
  document.getElementById("resultSection").style.display = "none";

  document.getElementById("status").textContent = "";

  document.getElementById("setupSection")
    .scrollIntoView({ behavior: "smooth" });

}

function escapeHTML(value) {

  return String(value).replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  })[char]);

}
</script>

</body>
</html>
